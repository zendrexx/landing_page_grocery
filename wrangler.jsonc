{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zebite",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Read by /feedback to show the public feedback board — see
  // lib/feedback-board.ts. OpenNext copies every string in the Worker env
  // into process.env at startup (dist/cli/templates/init.js,
  // populateProcessEnv), so these arrive as process.env.SUPABASE_*.
  //
  // The anon key is committed deliberately: it is Supabase's *publishable*
  // key, RLS is the actual protection, and the Zebite app already ships this
  // exact string to every user who installs it. Committing it is the same
  // exposure, and it keeps deploying to a single `npm run deploy` with no
  // secret to set up first.
  //
  // The service_role key must NEVER appear here — it bypasses RLS entirely.
  "vars": {
    "SUPABASE_URL": "https://mvdupfxkczgbyavlefsg.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im12ZHVwZnhrY3pnYnlhdmxlZnNnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQwMDU4NDEsImV4cCI6MjA5OTU4MTg0MX0.3pILEThQydJIeKnTs0cXYoPe-GhNhtQrdk2IN-qZ8G0"
  }
  // The WAITLIST Durable Object binding was removed when the waitlist came
  // down at release — nothing in this Worker reads a counter any more. The
  // zebite-waitlist-do Worker is deliberately left deployed and its source
  // kept at worker/waitlist-do/: its storage still holds the final signup
  // count, and unbinding is reversible in a way that deleting it is not.
}
