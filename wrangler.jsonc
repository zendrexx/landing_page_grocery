{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zebite",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // The WaitlistCounter class lives in its own Worker
  // (worker/waitlist-do/), not in this one — OpenNext regenerates this
  // Worker's entry point on every build, so it can't own a Durable
  // Object class itself. `script_name` binds cross-script to that
  // Worker instead. Deploy/redeploy it with `npm run deploy:waitlist-do`
  // (it owns the class's migrations, so none are declared here).
  "durable_objects": {
    "bindings": [
      { "name": "WAITLIST", "class_name": "WaitlistCounter", "script_name": "zebite-waitlist-do" }
    ]
  }
}
